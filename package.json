{
  "name": "inputism-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter inputism build",
    "demo": "pnpm --filter inputism-demo dev",
    "test": "pnpm --filter inputism-test test",
    "format": "prettier --write './{apps,packages}/**/*.{ts,html,json,css}' './*.{json,md,yaml,yml}'"
  },
  "devDependencies": {
    "prettier": "catalog:"
  },
  "engines": {
    "node": "24",
    "pnpm": "11"
  }
}
