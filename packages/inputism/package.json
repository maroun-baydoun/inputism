{
  "name": "inputism",
  "version": "0.0.2",
  "description": "Turn images into checkbox mosaics",
  "repository": {
    "type": "git",
    "url": "https://github.com/maroun-baydoun/inputism.git"
  },
  "homepage": "https://dev.maroun-baydoun.com/inputism/",
  "type": "module",
  "main": "dist/core.js",
  "module": "dist/core.js",
  "types": "dist/core.d.ts",
  "sideEffects": [
    "./dist/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build:clean": "rimraf dist",
    "build:js": "vite build",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist --project tsconfig.json",
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "prepublishOnly": "pnpm run build",
    "release:patch": "pnpm version patch",
    "release:minor": "pnpm version minor",
    "release:major": "pnpm version major",
    "release:beta": "pnpm version prerelease --preid beta",
    "release:beta-major": "pnpm version premajor --preid beta",
    "release:beta-minor": "pnpm version preminor --preid beta",
    "release:beta-patch": "pnpm version prepatch --preid beta"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
